<%- include('partials/header') %>
<section class="result-page">
  <div class="container">
    <div class="result-toolbar no-print">
      <a href="/" class="back-link">← Retour au portail</a>
    </div>

    <% if (candidate) { %>
      <!-- DOCUMENT AUTHENTIQUE CONFIRMÉ -->
      <div class="verification-banner is-valid">
        <div class="banner-icon">✓</div>
        <div>
          <h2>Exemple trouvé dans les données de démonstration</h2>
          <p>Cette vérification concerne uniquement un exemple fictif. Elle ne confirme aucun document officiel et n'a aucune valeur administrative.</p>
        </div>
      </div>

      <div class="result-header">
        <div>
          <div class="eyebrow"><span class="eyebrow-line"></span> Code de démonstration <%= candidate.verification_code %></div>
          <h1><%= candidate.exam %> <span>— Session <%= candidate.session_year %></span></h1>
          <p class="result-subtitle">Candidat : <strong><%= candidate.last_name %> <%= candidate.first_name %></strong> · N° PV <strong><%= candidate.pv_number %></strong></p>
        </div>
        <div class="status-badge <%= candidate.status === 'Admis' ? 'is-success' : (candidate.status === 'Admissible' ? 'is-eligible' : 'is-failed') %>">
          <span class="status-dot"></span><%= candidate.status %>
        </div>
      </div>

      <div class="result-layout">
        <div class="result-main">
          <!-- État civil certifié -->
          <section class="result-card identity-card">
            <div class="section-title"><span class="section-number">01</span><h2>Informations fictives du candidat</h2></div>
            <div class="identity-grid">
              <div><small>Nom et prénoms</small><strong><%= candidate.last_name %> <%= candidate.first_name %></strong></div>
              <div><small>Date et lieu de naissance</small><strong><%= candidate.birth_date %> · <%= candidate.birth_place %></strong></div>
              <div><small>Genre</small><strong><%= candidate.gender %></strong></div>
              <div><small>Numéro de PV</small><strong><%= candidate.pv_number %></strong></div>
            </div>
          </section>

          <!-- Détails fictifs de l'examen -->
          <section class="result-card">
            <div class="section-title"><span class="section-number">02</span><h2>Informations de délibération</h2></div>
            <div class="composition-grid">
              <div><small>Examen & Série</small><strong><%= candidate.exam %> — <%= candidate.series %></strong></div>
              <div><small>Tour de délibération</small><strong><%= candidate.round %></strong></div>
              <div><small>Centre de composition</small><strong><%= candidate.center %></strong></div>
              <div><small>Jury & Région</small><strong><%= candidate.jury %> (<%= candidate.region %>)</strong></div>
            </div>
          </section>

          <!-- Notes fictives -->
          <section class="result-card grades-card">
            <div class="section-title"><span class="section-number">03</span><h2>Notes de démonstration</h2></div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Matière</th>
                    <th class="numeric">Note / 20</th>
                    <th class="numeric">Coefficient</th>
                    <th class="numeric">Points</th>
                  </tr>
                </thead>
                <tbody>
                  <% candidate.grades.forEach((grade) => { %>
                    <tr>
                      <td><%= grade.subject %></td>
                      <td class="numeric"><strong><%= formatScore(grade.score) %></strong></td>
                      <td class="numeric"><%= grade.coefficient %></td>
                      <td class="numeric"><%= formatScore(grade.score * grade.coefficient) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <aside class="result-aside">
          <div class="score-card">
            <span class="score-label">Moyenne de démonstration</span>
            <div class="score"><%= formatScore(candidate.average) %><small>/20</small></div>
            <div class="score-divider"></div>
            <span class="mention-label">Mention</span>
            <strong class="mention"><%= candidate.mention || '—' %></strong>
            <div class="score-mark <%= candidate.status === 'Admis' ? 'success-mark' : 'failed-mark' %>">
              <%= candidate.status === 'Admis' ? '✓' : '!' %>
            </div>
          </div>

          <div class="notice-card">
            <strong>Relevé fictif</strong>
            <p>Le PDF téléchargé est un exemple de démonstration, sans valeur officielle.</p>
            <a href="/resultats/<%= candidate.pv_number %>/pdf" class="primary-button small-button" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">
              Télécharger le PDF de démo <span>↓</span>
            </a>
          </div>
        </aside>
      </div>

    <% } else { %>
      <!-- CODE INTROUVABLE OU FALSIFIÉ -->
      <div class="verification-banner is-invalid">
        <div class="banner-icon">✕</div>
        <div>
          <h2>Document Non Reconnu ou Code Invalide</h2>
          <p>Le code fourni (<code><%= queryCode || 'Inconnu' %></code>) ne correspond à aucun exemple fictif de la base de démonstration.</p>
        </div>
      </div>

      <div class="search-card" style="max-width: 500px; margin: 40px auto;">
        <h2>Vérifier un autre document</h2>
        <p>Saisissez le code de démonstration figurant au bas du relevé :</p>
        <form action="/verifier" method="get">
          <label for="code">Code de vérification</label>
          <input type="text" id="code" name="code" placeholder="BF-…" required>
          <button type="submit" class="primary-button" style="margin-top: 15px;">Vérifier l'exemple <span>→</span></button>
        </form>
      </div>
    <% } %>

  </div>
</section>
<%- include('partials/footer') %>
