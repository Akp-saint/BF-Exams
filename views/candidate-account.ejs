<%- include('partials/header') %>
<section class="info-section container">
  <div class="search-card" style="max-width:560px;margin:auto;">
    <div class="eyebrow">Portail candidat</div>
    <h1><%= mode === 'create' ? 'Créer mon compte candidat' : 'Connexion candidat' %></h1>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="<%= mode === 'create' ? '/inscription/creer-compte' : '/inscription/connexion' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="phone">Téléphone <span>*</span></label>
      <input id="phone" name="phone" type="tel" placeholder="+226 70 00 00 00" required>
      <% if (mode === 'create') { %>
        <label for="full_name">Nom complet</label>
        <input id="full_name" name="full_name" type="text" required>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email">
      <% } %>
      <label for="password">Mot de passe <span>*</span></label>
      <input id="password" name="password" type="password" minlength="8" required>
      <button class="primary-button" type="submit"><%= mode === 'create' ? 'Créer mon compte' : 'Se connecter' %> <span>→</span></button>
    </form>
    <% if (mode === 'create') { %><p class="field-help">Déjà inscrit ? <a href="/inscription/connexion">Se connecter</a></p><% } else { %><p class="field-help">Pas encore de compte ? <a href="/inscription/creer-compte">Créer un compte</a></p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
