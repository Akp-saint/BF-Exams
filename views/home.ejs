<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span> Projet indépendant · Démonstration</div>
      <h1>Un portail de résultats,<br><em>en version démo.</em></h1>
      <p class="hero-intro">Explorez un exemple de portail d'examens. Les résultats, comptes et paiements sont simulés et n'ont aucune valeur officielle.</p>
      
      <div class="exam-pills" aria-label="Examens disponibles">
        <span>CEP</span><span>BEPC</span><span>BAC (Séries A4, D, C, G2...)</span>
      </div>

      <div class="hero-actions">
        <a href="/inscription" class="primary-button hero-primary">S'inscrire à un examen <span>→</span></a>
        <a href="/statistiques" class="outline-button" style="display:inline-flex; align-items:center; gap:6px;">
          📊 Statistiques Nationales
        </a>
        <a href="/proclamations" class="outline-button" style="display:inline-flex; align-items:center; gap:6px;">
          📋 Listes par Jury
        </a>
        <a href="/verifier" class="outline-button" style="display:inline-flex; align-items:center; gap:6px;">
          🔍 Vérifier un QR Code
        </a>
      </div>
    </div>

    <div class="search-card">
      <div class="card-heading">
        <div class="card-icon">01</div>
        <div>
          <h2>Consulter un résultat</h2>
          <p>PV et date de naissance requis.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><span>!</span><%= error %></div>
      <% } %>

      <form action="/resultats" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Choix de l'examen -->
        <label for="exam">Type d’examen <span>*</span></label>
        <select id="exam" name="exam" required>
          <option value="" disabled <%= !selectedExam ? 'selected' : '' %>>Sélectionner un examen</option>
          <option value="CEP" <%= selectedExam === 'CEP' ? 'selected' : '' %>>CEP — Certificat d'études primaires</option>
          <option value="BEPC" <%= selectedExam === 'BEPC' ? 'selected' : '' %>>BEPC — Brevet d'études du premier cycle</option>
          <option value="BAC" <%= selectedExam === 'BAC' ? 'selected' : '' %>>BAC — Baccalauréat (Toutes séries)</option>
        </select>

        <!-- Numéro de PV -->
        <label for="pv">Numéro de PV <span>*</span></label>
        <div class="input-wrap">
          <span class="input-prefix">PV</span>
          <input id="pv" name="pv" type="text" value="<%= pvNumber %>" placeholder="Ex. BAC-2026-0837" autocomplete="off" required>
        </div>
        <p class="field-help">Utilisez uniquement les références fictives affichées ci-dessous.</p>

        <!-- Date de naissance (Confidentialité CIL) -->
        <label for="dob">Date de naissance <span>*</span></label>
        <input id="dob" name="dob" type="text" value="<%= typeof birthDate !== 'undefined' ? birthDate : '' %>" placeholder="Ex. 22/09/2007 ou 2007-09-22" autocomplete="off" required>
        <p class="field-help">Les données affichées sont fictives et servent uniquement à la démonstration.</p>

        <label for="captcha">Petit défi arithmétique <span>*</span></label>
        <div class="captcha-container">
          <span class="captcha-badge"><%= captchaQuestion %></span>
          <input type="text" id="captcha" name="captcha" class="captcha-input" placeholder="Résultat" required autocomplete="off">
          <input type="hidden" name="_captchaToken" value="<%= captchaToken %>">
        </div>

        <button class="primary-button" type="submit">Consulter mon relevé <span>→</span></button>
      </form>

      <div class="demo-note">
        <strong>Exemples fictifs pour tester :</strong><br>
        • BAC (Admis Bien) : <code>BAC-2026-0837</code> (Né le <code>22/09/2007</code>)<br>
        • BAC (2nd tour) : <code>BAC-2026-0412</code> (Né le <code>14/04/2007</code>)<br>
        • BEPC : <code>BEPC-2026-0142</code> (Né le <code>07/11/2010</code>)
      </div>
    </div>
  </div>
</section>

<section class="trust-strip">
  <div class="container trust-grid">
    <div class="trust-item"><span class="trust-icon">✓</span><div><strong>Relevé de démonstration</strong><small>Sans valeur officielle</small></div></div>
    <div class="trust-item"><span class="trust-icon">◷</span><div><strong>Disponible 24h/24 & Temps Réel</strong><small>Plateforme optimisée haute charge</small></div></div>
    <div class="trust-item"><span class="trust-icon">▣</span><div><strong>Jeu de données fictif</strong><small>N'utilisez aucune donnée personnelle réelle</small></div></div>
  </div>
</section>

<section class="info-section container">
  <div>
    <div class="eyebrow">Projet de démonstration indépendant</div>
    <h2>Transparence et modernité pour les examens scolaires</h2>
  </div>
  <p>Cette application illustre des parcours de consultation et d'inscription avec des données fictives. Elle n'est ni un service public ni un portail officiel, et n'est affiliée à aucune administration.</p>
</section>
<%- include('partials/footer') %>
